# Configure these environment variables only when using local integrations.
# Empty values keep the synthetic demo and disable optional integrations.
PM_PRIVATE_DIR=
PM_WORKBOOK=
PM_CASE_CONFIG=
PM_SNAPSHOT=
PM_EVIDENCE=
PM_BENCHMARK=
PM_LLM_URL=
PM_LLM_PROMPT_FILE=
METRIKA_COUNTER_ID=
METRIKA_TOKEN=

PM_LLM_MODEL=qwen3-4b

# Only explicit public catalogue values are sent to the optional adapter.
YANDEX_SEARCH_ENABLED=false
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_ALLOWED_DOMAINS=[]
YANDEX_SEARCH_PUBLIC_PRODUCTS=[]
YANDEX_SEARCH_MAX_RESULTS=5
YANDEX_SEARCH_MAX_QUERIES_PER_RUN=5
YANDEX_SEARCH_DAILY_LIMIT=20
YANDEX_SEARCH_CACHE_TTL=86400
YANDEX_SEARCH_LIVE_SMOKE=false

METRIKA_SCOPE=demo_counter
METRIKA_GOALS={}
METRIKA_SEGMENTS={}

# Empty disables periodic local comparisons. Allowed range: 60..86400 seconds.
PM_MONITOR_INTERVAL=
PM_LLM_SELECT_STEP=false
PM_MONITOR_DAILY_LIMIT=4
