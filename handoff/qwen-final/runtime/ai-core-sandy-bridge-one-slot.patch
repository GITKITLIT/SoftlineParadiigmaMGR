+SANDY_BRIDGE_BUDGET = InvestigationBudget(280, 95, 210, 170, 500)
+
+
+def single_slot_investigation(analyze):
+    @wraps(analyze)
+    def run(*args, **kwargs):
+        if os.getenv("PM_QWEN_RUNTIME_PROFILE") != "sandy-bridge-one-slot":
+            return analyze(*args, **kwargs)
+        if not INVESTIGATION_ADMISSION.acquire(blocking=False):
+            raise ValueError("Очередь расследований заполнена. Повторите после завершения одного из них.")
+        try:
+            budget = SANDY_BRIDGE_BUDGET
+            if not INVESTIGATION_SLOT.acquire(timeout=budget.total):
+                raise ValueError("Время ожидания запуска расследования истекло. Повторите запрос.")
+            try:
+                return analyze(*args, **kwargs, _budget=budget)
+            finally:
+                INVESTIGATION_SLOT.release()
+        finally:
+            INVESTIGATION_ADMISSION.release()
+
+    return run


