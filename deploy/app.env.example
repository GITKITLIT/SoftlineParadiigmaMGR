# systemd EnvironmentFile. Edit only on the target, as administrator.
PARADIIGMA_MODE=demo
PM_PRIVATE_DIR=/var/lib/paradiigma/db
PM_WORKBOOK=
PM_CASE_CONFIG=
PM_SNAPSHOT=
PM_EVIDENCE=
PM_BENCHMARK=
PM_DB_MAX_MIB=
PM_BACKUP_STATUS_FILE=/var/lib/paradiigma-backup-status/status.json
PM_MIGRATION_STATUS_FILE=/var/lib/paradiigma-backup-status/status.json

# Local Qwen model. Set PM_LLM_URL only when the model is ready.
PM_LLM_URL=
PM_LLM_MODEL=qwen3-4b
PM_LLM_PROMPT_FILE=
PM_LLM_SELECT_STEP=false
PM_QWEN_CHAT_ENABLED=false
PM_QWEN_OWNER_MODE=proxy
PM_QWEN_PROXY_KEY=
PM_QWEN_QUALITATIVE=false

PM_MONITOR_INTERVAL=
PM_MONITOR_DAILY_LIMIT=4
PM_COLLECTION_INTERVAL=0
PM_COLLECT_METRIKA=false
PM_SALES_SOURCE_ID=sales_export
PM_SALES_METHOD=weekly-index-v1
PM_SALES_TIMEZONE=Europe/Moscow

METRIKA_COUNTER_ID=
METRIKA_TOKEN=
METRIKA_SCOPE=demo_counter
METRIKA_COUNTER_TIMEZONE=Europe/Moscow
METRIKA_GOALS={}
METRIKA_SEGMENTS={}
METRIKA_EXTRA_METRICS={}
PM_METRIKA_DAILY_LIMIT=4
PM_METRIKA_PRODUCT=store

YANDEX_SEARCH_ENABLED=false
YANDEX_SEARCH_FOLDER_ID=
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_ALLOWED_DOMAINS=[]
YANDEX_SEARCH_PUBLIC_PRODUCTS=[]
YANDEX_SEARCH_PUBLIC_ALIASES={}
YANDEX_SEARCH_MAX_RESULTS=5
YANDEX_SEARCH_MAX_QUERIES_PER_RUN=5
YANDEX_SEARCH_DAILY_LIMIT=20
YANDEX_SEARCH_CACHE_TTL=86400
YANDEX_SEARCH_LIVE_SMOKE=false
YANDEX_SEARCH_MONITOR_ENABLED=false
YANDEX_SEARCH_PAGE_FETCH_ENABLED=false
YANDEX_SEARCH_PAGE_ALLOWED_DOMAINS=[]
YANDEX_SEARCH_MAX_PAGES_PER_RUN=3
YANDEX_SEARCH_PAGE_REQUESTS_PER_RUN=8
YANDEX_SEARCH_PAGE_DAILY_LIMIT=30
YANDEX_SEARCH_PAGE_CACHE_TTL=3600

PM_EMAIL_ENABLED=false
PM_EMAIL_TEST_MODE=true
PM_SMTP_HOST=
PM_SMTP_PORT=
PM_SMTP_SECURITY=starttls
PM_SMTP_USERNAME=
PM_SMTP_PASSWORD=
PM_EMAIL_FROM=
PM_EMAIL_TO=
PM_EMAIL_DAILY_LIMIT=4
PM_EMAIL_REPORT_BASE_URL=
