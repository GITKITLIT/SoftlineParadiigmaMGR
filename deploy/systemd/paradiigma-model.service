[Unit]
Description=Local Qwen3-4B for ParadiigmaMGR

[Service]
Type=simple
User=paradiigma-model
Group=paradiigma-model
ExecStart=/opt/llama/bin/llama-server --host 127.0.0.1 --port 18081 --model /var/lib/paradiigma-model/qwen3-4b.gguf --alias qwen3-4b --ctx-size 8192 --parallel 1 --reasoning-budget 0
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
InaccessiblePaths=-/var/lib/paradiigma -/var/lib/paradiigma-backup -/var/lib/paradiigma-backup-status -/etc/paradiigma -/etc/paradiigma-backup

[Install]
WantedBy=multi-user.target
