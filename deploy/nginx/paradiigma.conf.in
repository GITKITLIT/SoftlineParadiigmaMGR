# Include once at http scope on a dedicated host. Render with render_proxy.py.
map $http_host $pm_host_ok {
    default 0;
    "@DOMAIN@" 1;
    "@DOMAIN@:443" 1;
}

map "$request_method|$http_origin" $pm_origin_ok {
    default 0;
    "GET|" 1;
    "GET|https://@DOMAIN@" 1;
    "POST|https://@DOMAIN@" 1;
}

# Canonicalize only navigation GETs to the literal homepage.
map "$request_method:$request_uri" $pm_redirect_home {
    default 0;
    ~^GET:/[?].+ 1;
}

limit_req_zone $binary_remote_addr zone=pm_rate:1m rate=6r/s;
limit_conn_zone $binary_remote_addr zone=pm_clients:1m;
limit_conn_zone $server_name zone=pm_total:1m;
log_format pm_status '$time_iso8601 $request_method $status $request_time';

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_reject_handshake on;
    access_log off;
    return 403;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @DOMAIN@;
    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    auth_basic "PARADIIGMA";
    auth_basic_user_file /etc/nginx/paradiigma.htpasswd;
    access_log /var/log/nginx/paradiigma-access.log pm_status;
    error_log /var/log/nginx/paradiigma-error.log crit;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'none'; script-src 'sha256-@SCRIPT_HASH@'; style-src 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'" always;

    if ($pm_host_ok = 0) { return 403; }
    if ($pm_origin_ok = 0) { return 403; }
    if ($pm_redirect_home) { return 302 https://@DOMAIN@/; }
    if ($is_args) { return 400; }

    client_max_body_size 150000;
    client_body_buffer_size 150k;
    client_body_timeout 15s;
    client_header_timeout 15s;
    keepalive_timeout 15s;
    send_timeout 60s;
    limit_req zone=pm_rate burst=24 nodelay;
    limit_req_status 429;
    limit_conn pm_clients 12;
    limit_conn pm_total 32;
    limit_conn_status 429;

    @DEMO_IMPORT_RULE@
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_pass_request_headers off;
        proxy_set_header Host 127.0.0.1:8080;
        proxy_set_header Origin http://127.0.0.1:8080;
        proxy_set_header Content-Type $http_content_type;
@QWEN_PROXY_HEADERS@
        proxy_set_header Connection close;
        proxy_connect_timeout 3s;
        proxy_send_timeout 30s;
        proxy_read_timeout 300s;
        proxy_next_upstream off;
        proxy_buffering off;
    }
}
