#include <tunables/global>

# systemd selects this profile on its initial exec of Python. Keep it across
# the single permitted subprocess exec to work with NoNewPrivileges=true.
profile paradiigma-launcher flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  /usr/bin/python3{,.12} mr,
  /usr/{,local/}lib/python3*/** mr,
  /usr/pyvenv.cfg r,
  /usr/bin/pyvenv.cfg r,
  /opt/paradiigma/releases/*/ r,
  /opt/paradiigma/releases/*/scripts/run_model.py r,
  /opt/paradiigma/releases/*/{scripts,pm}/ r,
  /opt/paradiigma/releases/*/pm/{__init__,settings}.py r,
  /opt/paradiigma/releases/*/pm/__pycache__/** r,
  /usr/local/bin/llama-server ixmr,
  /usr/local/lib/** mr,
  /sys/devices/system/{cpu,node}/** r,
  @{PROC}/cpuinfo r,
  @{PROC}/meminfo r,
  @{PROC}/sys/vm/* r,
  /var/lib/paradiigma/models/*.gguf mr,
  network inet stream,
  network inet6 stream,
  signal (receive),
  signal (send) peer=paradiigma-launcher,
}
